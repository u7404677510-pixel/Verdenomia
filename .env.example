# ===========================================
# Verdenomia - Variables d'environnement
# ===========================================
# Copier ce fichier en .env.local et remplir les valeurs

# --- Tracking Meta Pixel ---
NEXT_PUBLIC_META_PIXEL_ID=

# --- Tracking Google Analytics / Google Ads ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_LABEL=
# Optionnel: labels specifiques par type de conversion
NEXT_PUBLIC_GADS_LABEL_PHONE=
NEXT_PUBLIC_GADS_LABEL_WA=

# --- Email (Resend) ---
RESEND_API_KEY=
NOTIFICATION_EMAIL=contacto@verdenomia.es

# --- Webhook externe (optionnel) ---
WEBHOOK_URL=
